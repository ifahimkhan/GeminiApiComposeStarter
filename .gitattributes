# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
