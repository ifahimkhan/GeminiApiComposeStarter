# Copy this file to local.properties and fill in your own key.
# local.properties is git-ignored -- never commit the real key.
#
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Android Studio writes this line itself on first sync; it is only listed here
# so the file shape is obvious.
# sdk.dir=/path/to/Android/Sdk
