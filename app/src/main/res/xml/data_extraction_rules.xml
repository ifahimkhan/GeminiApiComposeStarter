<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. The encrypted API key is excluded everywhere: its Android Keystore
   key never leaves the device, so a copied ciphertext could not be decrypted anyway.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_api_key.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_api_key.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
