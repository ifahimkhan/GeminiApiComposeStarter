<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for Android 12+.
   The encrypted API key is device-bound (Android Keystore), so it is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
