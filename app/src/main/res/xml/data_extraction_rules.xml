<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. Same reasoning as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
