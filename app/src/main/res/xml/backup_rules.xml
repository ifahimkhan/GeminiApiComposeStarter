<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted API key lives in DataStore. Its Keystore key is device-bound and can
     never be backed up, so ciphertext restored onto another device would be undecryptable.
     Excluding the directory keeps useless (and sensitive-looking) data out of backups. -->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
