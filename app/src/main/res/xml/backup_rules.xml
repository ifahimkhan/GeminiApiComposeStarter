<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup rules. The encrypted API key is bound to this device's Keystore, so a
     restored copy on another device would be undecryptable: keep it out of backups. -->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
</full-backup-content>
