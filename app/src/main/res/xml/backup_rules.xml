<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower.
   The encrypted API key is excluded: its Keystore key never leaves this device,
   so a restored ciphertext could not be decrypted on another device anyway.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
</full-backup-content>
